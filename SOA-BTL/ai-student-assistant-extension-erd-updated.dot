  message_documents [shape=box, fillcolor="#dbeafe", margin="0.14,0.10", label=<<B>MESSAGE_DOCUMENTS</B><BR/><FONT POINT-SIZE="12">Toàn bộ tài liệu đã dùng cho tin nhắn</FONT>>];
