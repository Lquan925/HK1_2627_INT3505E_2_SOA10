// Đặc tả ERD logic/vật lý đề xuất; chưa tạo bảng hay migration.
// Sinh SVG: dot -Tsvg ai-student-assistant-extension-erd-updated.dot -o ai-student-assistant-extension-erd-updated.svg
// Giữ file SVG gốc để so sánh. Mọi mã định danh ngoại hệ thống giữ dạng text.
// CLIENT_SESSIONS: token_hash UNIQUE; expires_at > created_at; thu hồi/hết hạn chặn mọi yêu cầu.
// DATA_CONSENTS UQ(client_session_id, data_category, purpose); không có bản ghi là chưa cấp quyền.
// CONSENT_COURSES PK(consent_id, course_id); SELECTED_COURSES cần >=1 dòng, ALL_AUTHORIZED_COURSES không có dòng.
// data_category: COURSE_DOCUMENTS / QUIZ_SUBMISSIONS / GRADE_BOOK.
// purpose: KNOWLEDGE_QA / KNOWLEDGE_SEARCH / DOCUMENT_SUMMARY / QUIZ_REVIEW / COMMENT_SUGGESTION / GRADE_PLANNING / LEARNING_ANALYSIS.
// Backend kiểm tra category-purpose phù hợp và consent trước khi đọc/lưu/trả dữ liệu.
// DOCUMENTS UQ(client_session_id, course_id, external_doc_id); index_status=PENDING / INDEXED / FAILED.
// DOCUMENT_CHUNKS UQ(document_id,index_generation,chunk_index); chunk_index>=0.
// DOCUMENTS.active_index_generation chọn thế hệ chỉ mục hiện hành; chỉ tìm kiếm trong thế hệ này.
// Đổi nội dung tạo index_generation mới; giữ chunks cũ cho citation rồi dọn theo chính sách lưu giữ.
// DOCUMENT_ACCESS là metadata kiểm tra nguồn gần nhất, không thay quyền Portal hiện tại.
// MESSAGE_DOCUMENTS / ANALYSIS_DOCUMENTS lưu toàn bộ phạm vi nguồn, kể cả tài liệu không được cite.
// Mọi liên kết FK phải cùng owner và đúng môn; owner bảng con suy ra từ FK tới bảng cha.
// CHAT_SESSIONS mode=GENERAL / COURSE_CONTEXT / MULTI_COURSE_SUMMARY.
// COURSE_CONTEXT cần course_id; GENERAL/MULTI_COURSE_SUMMARY có course_id/course_name=NULL.
// CHAT_MESSAGES role=USER / ASSISTANT; message_type=CHAT / SUMMARY.
// USER: answer_status=NULL, không citation/kiến thức ngoài nguồn.
// SUMMARY: role=ASSISTANT, coverage_note khác rỗng; lưu cờ partial cho lịch sử.
// CHAT: is_partial_content=false, coverage_note=NULL.
// answer_status: ANSWERED / INSUFFICIENT_CONTEXT, hoặc NULL theo role.
// QUIZ_REVIEWS quiz_status=GRADED; assessment_status=COMPLETE / PARTIAL / QUALITATIVE_ONLY.
// QUIZ_REVIEW_ITEMS UQ(review_id,question_number); question_number>=1; question_type=MULTIPLE_CHOICE / ESSAY.
// max_points>0; 0<=official_points<=max_points; ai_estimated_points=NULL khi thiếu rubric, nếu có phải trong [0,max_points].
// Tổng điểm chỉ có khi đủ căn cứ; không so sánh điểm khác thang.
// data_source=PORTAL / MANUAL, giữ nguyên nguồn khi tái sử dụng.
// used_data_categories lưu QUIZ_SUBMISSIONS/GRADE_BOOK thực tế đã dùng; MANUAL dùng mảng rỗng.
// PORTAL phải còn consent cho từng category/purpose đã sử dụng khi đọc lại dữ liệu.
// GRADE_GOALS: 0<=target_score<=max_scale; max_scale>=1; grading_rule=WEIGHTED_AVERAGE.
// scope_type=QUIZ_AVERAGE cần quiz_group_id; COURSE_FINAL có quiz_group_id=NULL.
// UQ mục tiêu theo (owner,course_id,scope_type,quiz_group_id); NULL nhóm phải được xem là trùng.
// Mục tiêu PORTAL cần consent GRADE_BOOK/GRADE_PLANNING đúng môn.
// UC09 tính trực tiếp; không có bảng lưu danh sách thành phần hoặc kết quả tính.
// LEARNING_RECOMMENDATIONS UQ(analysis_id,priority_rank); priority_rank>=1.
// observed_evidence là mảng JSONB không rỗng, tách riêng ai_inference.
// LEARNING_EVIDENCE giữ câu hỏi/điểm chi tiết; không suy luận chủ đề từ điểm tổng.
// Tài liệu và chủ đề liên quan phải cùng owner/môn; related_document_id có thể NULL.
// Thu hồi consent phải chặn cả bằng chứng, nguồn tài liệu và nội dung suy ra.
// UC07 sinh comment tức thời, không có bảng lưu comment. UC09 không lưu đầu vào/kết quả.
// Cần chốt mô hình/kích thước D của embedding trước khi tạo cột vector(D) và chỉ mục ANN.
graph ERD_UPDATED {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.24", ranksep="0.8", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Arial", fontsize=22, labelloc=t, label="AI STUDENT ASSISTANT — ERD ĐÃ CẬP NHẬT\nPhù hợp hợp đồng OpenAPI 2.0.0 • Phiên ẩn danh • 18 thực thể"];
  node [fontname="Arial", fontsize=12, color="#334155", penwidth=1.2, style=filled];
  edge [fontname="Arial", fontsize=11, color="#64748b", fontcolor="#334155", penwidth=1.0];
  client_sessions [shape=box, fillcolor="#dbeafe", margin="0.14,0.10", label=<<B>CLIENT_SESSIONS</B><BR/><FONT POINT-SIZE="12">Phiên Extension ẩn danh</FONT>>];
  client_sessions_a0 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<<U>id : uuid [PK]</U>>];
  client_sessions -- client_sessions_a0 [color="#94a3b8", weight=1];
  client_sessions_a1 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<token_hash : text [UQ]>];
  client_sessions -- client_sessions_a1 [color="#94a3b8", weight=1];
  client_sessions_a2 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<created_at : timestamptz>];
  client_sessions -- client_sessions_a2 [color="#94a3b8", weight=1];
  client_sessions_a3 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<expires_at : timestamptz>];
  client_sessions -- client_sessions_a3 [color="#94a3b8", weight=1];
  client_sessions_a4 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<revoked_at : timestamptz ?>];
  client_sessions -- client_sessions_a4 [color="#94a3b8", weight=1];
  data_consents [shape=box, fillcolor="#dbeafe", margin="0.14,0.10", label=<<B>DATA_CONSENTS</B><BR/><FONT POINT-SIZE="12">Quyền sử dụng dữ liệu</FONT>>];
  data_consents_a0 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<<U>id : uuid [PK]</U>>];
  data_consents -- data_consents_a0 [color="#94a3b8", weight=1];
  data_consents_a1 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<client_session_id : uuid [FK]>];
  data_consents -- data_consents_a1 [color="#94a3b8", weight=1];
  data_consents_a2 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<data_category : text>];
  data_consents -- data_consents_a2 [color="#94a3b8", weight=1];
  data_consents_a3 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<purpose : text>];
  data_consents -- data_consents_a3 [color="#94a3b8", weight=1];
  data_consents_a4 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<is_granted : boolean>];
  data_consents -- data_consents_a4 [color="#94a3b8", weight=1];
  data_consents_a5 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<scope_type : text>];
  data_consents -- data_consents_a5 [color="#94a3b8", weight=1];
  data_consents_a6 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<updated_at : timestamptz>];
  data_consents -- data_consents_a6 [color="#94a3b8", weight=1];
  data_consents_a7 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<granted_at : timestamptz ?>];
  data_consents -- data_consents_a7 [color="#94a3b8", weight=1];
  data_consents_a8 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<revoked_at : timestamptz ?>];
  data_consents -- data_consents_a8 [color="#94a3b8", weight=1];
  consent_courses [shape=box, fillcolor="#dbeafe", margin="0.14,0.10", label=<<B>CONSENT_COURSES</B><BR/><FONT POINT-SIZE="12">Môn học trong phạm vi consent</FONT>>];
  consent_courses_a0 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<<U>consent_id : uuid [PK, FK]</U>>];
  consent_courses -- consent_courses_a0 [color="#94a3b8", weight=1];
  consent_courses_a1 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<<U>course_id : text [PK]</U>>];
  consent_courses -- consent_courses_a1 [color="#94a3b8", weight=1];
  documents [shape=box, fillcolor="#dbeafe", margin="0.14,0.10", label=<<B>DOCUMENTS</B><BR/><FONT POINT-SIZE="12">Tài liệu thuộc phiên</FONT>>];
  documents_a0 [shape=ellipse, fillcolor="#fef3c7", fontsize=11, margin="0.10,0.04", label=<<U>id : uuid [PK]</U>>];
