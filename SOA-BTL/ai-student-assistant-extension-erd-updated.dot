  note_legend [shape=note, fillcolor="#f8fafc", color="#94a3b8", fontsize=12, margin="0.20,0.15", label="CHÚ GIẢI\nChữ nhật: thực thể • Elip: thuộc tính • Thoi: quan hệ\nPK gạch chân • FK: khóa ngoại • UQ: duy nhất • ?: NULL\nID nội bộ: UUID • Mã Portal: text\nThời gian: timestamptz • Điểm: numeric\nvector(D): chốt D theo mô hình embedding, không tự giả định"];
  note_ownership [shape=note, fillcolor="#f8fafc", color="#94a3b8", fontsize=12, margin="0.20,0.15", label="QUYỀN SỞ HỮU VÀ NGUỒN\nMọi tài nguyên và liên kết phải cùng phiên, đúng môn.\nChỉ lưu token_hash; không lưu token/cookie/mật khẩu Portal.\nConsent cần kiểm tra lại trước khi đọc, lưu và trả kết quả.\nBảng nối nguồn giữ cả tài liệu không được trích dẫn.\nThu hồi quyền chặn cả dữ liệu và nội dung dẫn xuất."];
  note_lifecycle [shape=note, fillcolor="#f8fafc", color="#94a3b8", fontsize=12, margin="0.20,0.15", label="QUY TẮC CHÍNH\nTài liệu duy nhất theo (owner, course_id, external_doc_id).\nChunks duy nhất theo (document_id, index_generation, chunk_index).\nactive_index_generation chọn chỉ mục mới; giữ chunks cũ cho citation.\nConsent duy nhất theo (owner, data_category, purpose).\nUC07 comment và UC09 tính điểm không lưu đầu vào/kết quả.\nChi tiết CHECK/UNIQUE và enum có trong chú thích file DOT."];
  note_legend -- note_ownership -- note_lifecycle [style=invis, weight=10];
}
