# Cấu hình chạy Python cục bộ. Chạy lệnh từ thư mục backend/.
# Docker Compose dùng .env ở thư mục gốc, theo .env.docker.example.
FLASK_APP=wsgi:app
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=8000

# Thư mục đặc tả tùy chọn; để trống để dùng bộ OpenAPI trong repo.
# Khi cài bằng wheel, sao chép toàn bộ thư mục đặc tả và đặt đường dẫn tuyệt đối tại đây.
OPENAPI_SPEC_DIR=

# Tạo giá trị riêng khi triển khai xác thực và phiên người dùng.
SECRET_KEY=

# Thay bằng thông tin PostgreSQL trên máy; mã hóa URL các ký tự đặc biệt.
# Nếu dùng database từ Compose, thông tin mặc định như sau:
DATABASE_URL=postgresql+psycopg://ai_student_assistant:student_assistant_local@localhost:5432/ai_student_assistant
# Hoặc bỏ trống DATABASE_URL và đặt riêng các biến DB_HOST, DB_PORT,
# DB_NAME, DB_USER, DB_PASSWORD; cách này giữ nguyên ký tự đặc biệt của mật khẩu.

# Chỉ điền khi chọn provider/model. Không đặt các khóa này trong Extension.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
