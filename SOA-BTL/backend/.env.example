# Flask CLI settings. Run commands from backend/.
FLASK_APP=wsgi:app
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=8000

# Generate a private value when implementing sessions/authentication.
SECRET_KEY=

# Replace the sample credentials with your local PostgreSQL settings.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg://ai_student_assistant:replace_me@localhost:5432/ai_student_assistant

# Provider/model selection is pending. Never put these keys in the extension.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
