# Sao chép thành .env ở thư mục gốc nếu cần đổi cấu hình Docker Compose.
# Các giá trị mặc định chỉ dùng cho môi trường phát triển cục bộ.
API_PORT=8000
POSTGRES_PORT=5432
POSTGRES_DB=ai_student_assistant
POSTGRES_USER=ai_student_assistant
POSTGRES_PASSWORD=student_assistant_local

# Chỉ điền khi đã triển khai chức năng tương ứng.
SECRET_KEY=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
